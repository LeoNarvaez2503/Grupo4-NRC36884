@model ApiPaisesMVC_SQLServer.Models.Pais
@{
    ViewData["Title"] = "Editar País";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card p-4">
            <h3 class="fw-bold mb-3 text-warning">Editar País: @Model.Nombre</h3>
            <form asp-action="Editar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label fw-semibold"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Capital" class="form-label fw-semibold"></label>
                        <input asp-for="Capital" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Region" class="form-label fw-semibold"></label>
                        <select asp-for="Region" class="form-select">
                            <option value="Americas">Americas (América)</option>
                            <option value="Europe">Europe (Europa)</option>
                            <option value="Asia">Asia</option>
                            <option value="Africa">Africa (África)</option>
                            <option value="Oceania">Oceania (Oceanía)</option>
                            <option value="Polar">Polar</option>
                            <option value="Antarctic">Antarctic</option>
                        </select>
                        <span asp-validation-for="Region" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="SubRegion" class="form-label fw-semibold"></label>
                        <input asp-for="SubRegion" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Poblacion" class="form-label fw-semibold"></label>
                        <input asp-for="Poblacion" type="number" min="0" class="form-control" />
                        <span asp-validation-for="Poblacion" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Area" class="form-label fw-semibold"></label>
                        <input asp-for="Area" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Area" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Moneda" class="form-label fw-semibold"></label>
                        <input asp-for="Moneda" class="form-control" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-semibold">
                        <i class="bi bi-check-lg me-1"></i> Actualizar
                    </button>
                    <a asp-action="Lista" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
