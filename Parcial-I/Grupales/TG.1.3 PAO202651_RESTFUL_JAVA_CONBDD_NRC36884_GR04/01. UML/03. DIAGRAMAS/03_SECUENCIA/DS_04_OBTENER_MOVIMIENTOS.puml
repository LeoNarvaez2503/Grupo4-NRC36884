@startuml
title "DS_04_OBTENER_MOVIMIENTOS (REST)"
autonumber

actor "Usuario" as Usuario
participant "CONVERSION_VISTA" as Vista
participant "CONVERSION_CONTROLADOR" as Controlador
participant "CLIENTE_REST_CONVERSOR\n(ConversorService)" as ClienteRest
participant "CONVERSOR_RESOURCE\n(/api/conversor)" as ConversorResource
participant "ADMINISTRADOR_TOKEN" as TokenMgr
participant "UNIDAD_MAPPER" as Mapper
participant "SERVICIO_CONVERSOR" as Servicio
participant "CONVERSOR_MASA" as ConvMasa

Usuario -> Vista: Selecciona [KILOGRAMO -> GRAMO], valor=2.5 y pulsa "Convertir"
Vista -> Controlador: convertirMasa(2.5, "KILOGRAMO", "GRAMO")
Controlador -> ClienteRest: convertirMasa(ConversionRequest)
activate ClienteRest

ClienteRest -> ConversorResource: HTTP POST /api/conversor/masa\nHeader Authorization: Bearer <token>\n{"valor": 2.5, "unidadInicial": "KILOGRAMO", "unidadFinal": "GRAMO"}
activate ConversorResource

ConversorResource -> TokenMgr: validarToken(token)
activate TokenMgr
TokenMgr --> ConversorResource: true
deactivate TokenMgr

ConversorResource -> Mapper: toMasa("KILOGRAMO"), toMasa("GRAMO")
activate Mapper
Mapper --> ConversorResource: UnidadMasa.KILOGRAMO, UnidadMasa.GRAMO
deactivate Mapper

ConversorResource -> Servicio: convertir(2.5, KILOGRAMO, GRAMO)
activate Servicio
Servicio -> ConvMasa: convertir(2.5, KILOGRAMO, GRAMO)
activate ConvMasa
ConvMasa --> Servicio: 2500.0
deactivate ConvMasa
Servicio --> ConversorResource: 2500.0
deactivate Servicio

ConversorResource --> ClienteRest: HTTP 200 OK\n{"valorOriginal": 2.5, "valorConvertido": 2500.0, "unidadInicial": "KILOGRAMO", "unidadFinal": "GRAMO"}
deactivate ConversorResource

ClienteRest --> Controlador: ConversionResponse(2500.0)
deactivate ClienteRest
Controlador --> Vista: mostrarResultado(2500.0)
Vista --> Usuario: "Resultado: 2500.0 GRAMO"
@enduml