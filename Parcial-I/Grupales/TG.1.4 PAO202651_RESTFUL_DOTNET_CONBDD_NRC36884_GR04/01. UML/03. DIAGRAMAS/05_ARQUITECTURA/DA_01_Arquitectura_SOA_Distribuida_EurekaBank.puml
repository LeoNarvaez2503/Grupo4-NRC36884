title DA_01: Diagrama de Arquitectura SOA Multicapa con Persistencia Local en Contenedor

package "Capa de PresentaciÃ³n (Clientes Multicanal)" {
    [Cliente Escritorio (Java Swing / WPF)] as UI_Desktop
    [Cliente Web (Jakarta Faces JSF / Blazor)] as UI_Web
    [Cliente MÃ³vil (Android Java / MAUI)] as UI_Mobile
    [Cliente Consola (Terminal CLI)] as UI_Cli
}

package "Capa de IntegraciÃ³n y Middleware SOA" {
    package "Endpoint Gateway" {
        [Servicio Web SOAP (JAX-WS / CoreWCF)] as WS_SOAP
        [API Web RESTful (JAX-RS / ASP.NET Web API)] as WS_REST
    }
    
    package "Capa de LÃ³gica del Negocio (Backend)" {
        [MÃ³dulo de Seguridad y Tokens] as SecurityModule
