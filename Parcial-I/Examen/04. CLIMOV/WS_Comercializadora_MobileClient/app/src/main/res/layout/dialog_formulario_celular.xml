<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTituloDialogoCelular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registrar Nuevo Celular"
        android:textColor="@color/brand_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Mantenimiento CRUD del Catálogo CelStore"
        android:textColor="@color/gray"
        android:textSize="12sp" />

    <!-- Marca -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Marca:"
        android:textColor="@color/brand_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etMarcaCelular"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:hint="Ej. Samsung, Apple, Xiaomi"
        android:inputType="textCapWords"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_navy"
        android:textSize="14sp" />

    <!-- Modelo -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Modelo:"
        android:textColor="@color/brand_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etModeloCelular"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:hint="Ej. Galaxy S24 Ultra"
        android:inputType="text"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_navy"
        android:textSize="14sp" />

    <!-- Precio -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Precio de Venta ($ USD):"
        android:textColor="@color/brand_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etPrecioCelular"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:hint="Ej. 750.00"
        android:inputType="numberDecimal"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_navy"
        android:textSize="14sp" />

    <!-- Características -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Características Técnicas:"
        android:textColor="@color/brand_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etCaracteristicasCelular"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:gravity="top|start"
        android:hint="Ej. Pantalla AMOLED 120Hz, 256GB, 8GB RAM"
        android:inputType="textMultiLine"
        android:padding="10dp"
        android:textColor="@color/brand_navy"
        android:textSize="13sp" />

    <!-- Estado -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Estado:"
        android:textColor="@color/brand_navy"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spnEstadoCelular"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:paddingHorizontal="8dp" />

    <!-- Botonera Acciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelarCelular"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_rounded_white"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="@color/gray"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnGuardarCelular"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/primary"
            android:text="💾 Guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
