<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/light_gray">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="COMERCIALIZADORA DE CELULARES"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Módulo de Crédito BanQuito | NRC: 36884 | Grupo 04"
        android:textSize="12sp"
        android:textColor="@color/gray"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnIrFacturacion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🛒 Facturación (Efectivo / Crédito)"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnIrCatalogo"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📱 Catálogo de Teléfonos Celulares"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnIrAmortizacion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🏦 Consultas BanQuito y Amortización"
        android:backgroundTint="@color/primary"
        android:textColor="@color/white"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvEstadoConexion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 Servicios RESTful Configurados (Puertos 8090 / 8080)"
        android:textSize="12sp"
        android:textColor="@color/accent"
        android:gravity="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
