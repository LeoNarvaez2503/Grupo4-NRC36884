<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/light_gray">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============================================== -->
        <!-- 1. HERO SHOWCASE CON SULLIVAN EN ALTA DEFINICIÓN -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_hero_gradient"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_gold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="★ GRUPO 04 - MONSTER"
                android:textColor="@color/accent"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="CelStore &amp; BanQuito"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Crédito Directo BanQuito (16.5% Anual)"
                android:textColor="#CBD5E1"
                android:textSize="12sp" />

            <!-- SULLIVAN VISIBLE Y NÍTIDO (100% OPACIDAD) -->
            <ImageView
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/sullivan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="James P. Sullivan • Mascota Oficial"
                android:textColor="#E2E8F0"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 2. FORMULARIO DE ACCESO                        -->
        <!-- ============================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/card_rounded_white"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Iniciar Sesión"
                android:textColor="@color/brand_navy"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ingrese sus credenciales para continuar"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <!-- Mensaje de Error -->
            <TextView
                android:id="@+id/tvErrorLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/badge_red"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Usuario -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Usuario:"
                android:textColor="@color/brand_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/card_rounded_white"
                android:hint="Monster"
                android:inputType="text"
                android:paddingHorizontal="14dp"
                android:text="Monster"
                android:textColor="@color/brand_navy"
                android:textSize="14sp" />

            <!-- Contraseña -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Contraseña:"
                android:textColor="@color/brand_navy"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etClave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/card_rounded_white"
                android:hint="Monster9"
                android:inputType="textPassword"
                android:paddingHorizontal="14dp"
                android:textColor="@color/brand_navy"
                android:textSize="14sp" />

            <!-- Botón Login -->
            <Button
                android:id="@+id/btnIngresar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="@color/primary"
                android:text="Ingresar al Sistema"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Botón Configurar Servidor / IP -->
            <Button
                android:id="@+id/btnConfigurarIpMobile"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/badge_amber"
                android:text="⚙️ Conectar a otro equipo (Cambiar IP)"
                android:textAllCaps="false"
                android:textColor="@color/brand_navy"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Hint de Credenciales Oficiales -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/card_rounded_white"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Credenciales Oficiales Requeridas:"
                    android:textColor="@color/gray"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Usuario: Monster  |  Contraseña: Monster9"
                    android:textColor="@color/brand_navy"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
