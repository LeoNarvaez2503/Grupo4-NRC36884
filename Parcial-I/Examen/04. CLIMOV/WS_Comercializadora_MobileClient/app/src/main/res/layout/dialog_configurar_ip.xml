<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configurar IP del Servidor"
        android:textColor="@color/brand_navy"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ingrese la dirección IP del servidor donde corre Payara Server (:8080)."
        android:textColor="@color/gray"
        android:textSize="12sp" />

    <!-- Campo IP / Host -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Dirección IP o Host:"
        android:textColor="@color/brand_navy"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDlgHost"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:hint="Ej. 192.168.18.249 o 10.0.2.2"
        android:inputType="textUri"
        android:paddingHorizontal="12dp"
        android:textColor="@color/brand_navy"
        android:textSize="14sp" />

    <!-- Campo Puerto -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Puerto HTTP (Payara):"
        android:textColor="@color/brand_navy"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etDlgPuerto"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/card_rounded_white"
        android:hint="8080"
        android:inputType="number"
        android:paddingHorizontal="12dp"
        android:text="8080"
        android:textColor="@color/brand_navy"
        android:textSize="14sp" />

    <!-- Presets Rápidos -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Presets Rápidos:"
        android:textColor="@color/gray"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPresetEmulador"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/badge_amber"
            android:text="Emulador (10.0.2.2)"
            android:textAllCaps="false"
            android:textColor="@color/brand_navy"
            android:textSize="10sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPresetLan"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/badge_green"
            android:text="LAN (192.168.18.249)"
            android:textAllCaps="false"
            android:textColor="#166534"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Estado de Prueba -->
    <TextView
        android:id="@+id/tvDlgEstadoPrueba"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:padding="8dp"
        android:textColor="@color/gray"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Botonera Acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDlgProbar"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/card_rounded_white"
            android:text="🔍 Probar"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDlgGuardar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary"
            android:text="💾 Guardar"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
