<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/sullivan"
        android:label="@string/app_name"
        android:roundIcon="@drawable/sullivan"
        android:supportsRtl="true"
        android:theme="@style/Theme.WSComercializadoraMobile"
        android:usesCleartextTraffic="true">
        
        <activity
            android:name=".view.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity android:name=".view.FacturacionActivity" android:exported="false" />
        <activity android:name=".view.CatalogoActivity" android:exported="false" />
        <activity android:name=".view.AmortizacionActivity" android:exported="false" />
        <activity android:name=".view.HistorialActivity" android:exported="false" />

    </application>

</manifest>
