@startuml
title "DS_05_CONVERTIR_TEMPERATURA (REST)"
autonumber

actor "Usuario" as Usuario
participant "CONVERSION_VISTA" as Vista
participant "CONVERSION_CONTROLADOR" as Controlador
participant "CLIENTE_REST_CONVERSOR\n(ConversorService)" as ClienteRest
participant "CONVERSOR_RESOURCE\n(/api/conversor)" as ConversorResource
participant "ADMINISTRADOR_TOKEN" as TokenMgr
participant "UNIDAD_MAPPER" as Mapper
participant "SERVICIO_CONVERSOR" as Servicio
participant "CONVERSOR_TEMPERATURA" as ConvTemp

Usuario -> Vista: Selecciona [CELSIUS -> FAHRENHEIT], valor=100 y pulsa "Convertir"
Vista -> Controlador: convertirTemperatura(100, "CELSIUS", "FAHRENHEIT")
Controlador -> ClienteRest: convertirTemperatura(ConversionRequest)
activate ClienteRest

ClienteRest -> ConversorResource: HTTP POST /api/conversor/temperatura\nHeader Authorization: Bearer <token>\n{"valor": 100.0, "unidadInicial": "CELSIUS", "unidadFinal": "FAHRENHEIT"}
activate ConversorResource

ConversorResource -> TokenMgr: validarToken(token)
activate TokenMgr
TokenMgr --> ConversorResource: true
deactivate TokenMgr

ConversorResource -> Mapper: toTemperatura("CELSIUS"), toTemperatura("FAHRENHEIT")
activate Mapper
Mapper --> ConversorResource: UnidadTemperatura.CELSIUS, UnidadTemperatura.FAHRENHEIT
deactivate Mapper

ConversorResource -> Servicio: convertir(100.0, CELSIUS, FAHRENHEIT)
activate Servicio
Servicio -> ConvTemp: convertir(100.0, CELSIUS, FAHRENHEIT)
activate ConvTemp
ConvTemp --> Servicio: 212.0
deactivate ConvTemp
Servicio --> ConversorResource: 212.0
deactivate Servicio

ConversorResource --> ClienteRest: HTTP 200 OK\n{"valorOriginal": 100.0, "valorConvertido": 212.0, "unidadInicial": "CELSIUS", "unidadFinal": "FAHRENHEIT"}
deactivate ConversorResource

ClienteRest --> Controlador: ConversionResponse(212.0)
deactivate ClienteRest
Controlador --> Vista: mostrarResultado(212.0)
Vista --> Usuario: "Resultado: 212.0 FAHRENHEIT"
@enduml