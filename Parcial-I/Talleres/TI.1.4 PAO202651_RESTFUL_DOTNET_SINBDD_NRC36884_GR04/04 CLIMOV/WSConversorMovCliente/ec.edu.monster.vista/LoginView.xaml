<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ec.edu.monster.vista.LoginView"
             Title="Iniciar Sesión"
             BackgroundColor="#F1F5F9"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24" VerticalOptions="Center">

            <!-- Logo Sullivan -->
            <Image Source="sullivan.png"
                   HeightRequest="120"
                   WidthRequest="120"
                   HorizontalOptions="Center"
                   Aspect="AspectFit" />

            <!-- Título del Sistema -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="MONSTER CONVERSOR"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       HorizontalTextAlignment="Center" />
                <Label Text="Cliente Móvil SOAP (.NET MAUI)"
                       FontSize="13"
                       TextColor="#64748B"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Card Formulario -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="#E2E8F0"
                    BackgroundColor="White"
                    Padding="20"
                    Margin="0,8,0,0">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,4" Radius="8" Opacity="0.08" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="14">

                    <!-- Campo Usuario -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Usuario"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CBD5E1"
                                BackgroundColor="#F8FAFC"
                                Padding="10,0">
                            <Entry x:Name="txtUsuario"
                                   Placeholder="Ej: Monster"
                                   Text="Monster"
                                   FontSize="15"
                                   TextColor="#0F172A"
                                   Keyboard="Text"
                                   ReturnType="Next" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Campo Contraseña -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Contraseña"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#334155" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#CBD5E1"
                                BackgroundColor="#F8FAFC"
                                Padding="10,0">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry x:Name="txtPassword"
                                       Grid.Column="0"
                                       Placeholder="Ej: Monster9"
                                       Text="Monster9"
                                       IsPassword="True"
                                       FontSize="15"
                                       TextColor="#0F172A"
                                       ReturnType="Done" />
                                <Button x:Name="btnTogglePass"
                                        Grid.Column="1"
                                        Text="👁"
                                        FontSize="16"
                                        BackgroundColor="Transparent"
                                        TextColor="#64748B"
                                        Padding="4"
                                        Clicked="btnTogglePass_Clicked" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Servidor / Endpoint Config -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Servidor SOAP (URL)"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#64748B" />
                        <Border StrokeShape="RoundRectangle 8"
                                Stroke="#E2E8F0"
                                BackgroundColor="#F8FAFC"
                                Padding="10,0">
                            <Entry x:Name="txtEndpointUrl"
                                   FontSize="12"
                                   TextColor="#475569"
                                   Keyboard="Url" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Mensaje de Estado / Error -->
                    <Label x:Name="lblMensaje"
                           FontSize="13"
                           TextColor="#DC2626"
                           HorizontalTextAlignment="Center"
                           IsVisible="False"
                           LineBreakMode="WordWrap" />

                    <!-- Indicador de carga -->
                    <ActivityIndicator x:Name="actCargando"
                                       IsRunning="False"
                                       IsVisible="False"
                                       Color="#0284C7"
                                       HeightRequest="36" />

                    <!-- Botón Ingresar -->
                    <Button x:Name="btnIngresar"
                            Text="INICIAR SESIÓN"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="#0284C7"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="48"
                            Clicked="btnIngresar_Clicked" />

                </VerticalStackLayout>
            </Border>

            <!-- Pie de página -->
            <Label Text="Grupo 4 - Universidad de las Fuerzas Armadas ESPE"
                   FontSize="11"
                   TextColor="#94A3B8"
                   HorizontalTextAlignment="Center"
                   Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
